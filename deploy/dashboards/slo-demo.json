        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_max(1 - ((1 - slo:demo_latency:ratio_3d) / 0.05), 1)",
          "legendFormat": "бюджет латентности"
        }
      ]
    },
    {
      "id": 3,
      "title": "Текущий SLI — доступность",
      "description": "Доля ok-исходов нагрузки за окно SLO (3 дня). Цель 99 %: ниже — бюджет тратится.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
