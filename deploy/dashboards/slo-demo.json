{
  "uid": "demo-slo",
  "title": "demo — SLI/SLO и burn rate",
  "tags": [
    "demo",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "сработавшие алерты demo (дриллы)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", service=\"demo-api\"}",
        "tagKeys": "alertname",
        "titleFormat": "{{alertname}} · {{slo}}",
        "textFormat": "{{severity}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Остаток бюджета ошибок — доступность",
      "description": "1 − (доля ошибок / бюджет 1 %). Окно SLO 3 дня. Ноль — бюджет исчерпан, отрицательное значение — перерасход. Шкала не обрезается снизу: −200 % и ниже — нормальный показ перерасхода, а не ошибка панели.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_max(1 - ((1 - slo:demo_availability:ratio_3d) / 0.01), 1)",
          "legendFormat": "бюджет доступности"
        }
      ]
    },
    {
      "id": 2,
      "title": "Остаток бюджета ошибок — латентность",
      "description": "1 − (доля запросов медленнее 300 мс / бюджет 5 %). Окно SLO 3 дня. Шкала не обрезается снизу: −200 % и ниже — нормальный показ перерасхода, а не ошибка панели.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
