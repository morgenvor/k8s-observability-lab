{
  "uid": "demo-red",
  "title": "demo — RED и латентность",
  "tags": [
    "demo",
    "red"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "RPS: сервер и клиент",
      "description": "Сервер — demo-api по маршруту /work (http_requests_total), клиент — demo-load (load_requests_total). Пробы /healthz, /ready и скрейп /metrics в серверную линию не входят: раньше они добавляли ~0,7 rps и мешали сравнивать. Клиент выше сервера — запросы не дошли до приложения (сеть, toxiproxy, отказ соединения).",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"demo-api\",route=\"/work\"}[5m]))",
          "legendFormat": "сервер demo-api"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(load_requests_total{job=\"demo-load\"}[5m]))",
          "legendFormat": "клиент demo-load"
        }
      ]
    },
    {
      "id": 2,
      "title": "Доля ошибок",
      "description": "Клиентская доля исходов не-ok (взгляд пользователя) и серверные 5xx.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(load_requests_total{job=\"demo-load\",outcome!=\"ok\"}[5m])) or vector(0)) / clamp_min(sum(rate(load_requests_total{job=\"demo-load\"}[5m])), 1e-9)",
          "legendFormat": "клиент: не-ok"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_requests_total{job=\"demo-api\",status_class=\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=\"demo-api\"}[5m])), 1e-9)",
          "legendFormat": "сервер: 5xx"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 латентности: сервер и клиент",
      "description": "Серверная гистограмма — работа demo-api, клиентская — что видит пользователь через toxiproxy (она идёт в SLO).",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"demo-api\"}[5m])))",
          "legendFormat": "сервер demo-api"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(load_request_duration_seconds_bucket{job=\"demo-load\"}[5m])))",
          "legendFormat": "клиент demo-load"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latency SLO: доля запросов ≤ 300 мс",
      "description": "Клиентская доля запросов ≤ 300 мс, окно 5 минут; цель 95 %. Считается по бакету le=0.3, то есть не зависит от грубости бакетов гистограммы. Важно: быстрый отказ (обрыв соединения, 1–2 мс) тоже попадает в этот бакет — панель может быть зелёной при полностью сгоревшем бюджете доступности. Ноль или провал панель показывает при медленной деградации (задержка > 300 мс, например дрилл latency), а при полном отсутствии трафика линии просто нет.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(load_request_duration_seconds_bucket{job=\"demo-load\",le=\"0.3\"}[5m])) / clamp_min(sum(rate(load_request_duration_seconds_count{job=\"demo-load\"}[5m])), 1e-9)",
          "legendFormat": "доля ≤ 300 мс"
        }
      ]
    },
    {
      "id": 5,
      "title": "Логи demo (Loki)",
      "description": "stdout подов namespace demo из Loki: demo-api, demo-load, alert-sink, toxiproxy. Строки — JSON, `| json` разбирает поля (status, duration_ms, request_id, outcome); они видны по клику на строку, фильтры удобнее строить в Explore. Пусто при живом трафике — смотреть доставку: kubectl -n monitoring logs ds/alloy -c alloy. Метки потока: namespace, app, pod, container (низкая кардинальность), retention 72h.",
      "type": "logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"demo\"} | json",
          "queryType": "range",
          "maxLines": 100
        }
      ]
    }
  ]
}
