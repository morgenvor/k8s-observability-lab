# Инструменты и загрузки bootstrap-tools.sh (восстанавливаются скриптом)
.tools/
.tmp/

# Node
node_modules/
dist/
npm-debug.log*

# Python: байткод ассертов в scripts/checks (восстанавливается запуском)
__pycache__/
*.pyc

# Образы и архивы
*.tar
*.tgz
*.tar.gz

# Локальная конфигурация и доступ к лабе.
# .secrets/ — каталог рядом с проектом: kubeconfig и ssh-конфиг лабы (копии для
# работы); в git он не попадает никогда. Шаблоны kubeconfig*/*.kubeconfig ловят
# файл, положенный в корень по ошибке.
.env
.secrets/
kubeconfig*
*.kubeconfig

# Логи в корне; evidence/*.console.log — доказательства и трекаются
/*.log

# Внутренний чек-лист релиза (поля репозитория, защита ветки, тег): процессные
# детали, в публикуемый набор не входят. Файл остаётся на диске, но не в git.
docs/publish.md

# ОС
.DS_Store
Thumbs.db
